# Local development edge. Production config ships with the deploy milestone.
{
	on_demand_tls {
		ask http://host.docker.internal:3000/api/internal/caddy/ask
	}
}

https:// {
	tls internal {
		on_demand
	}

	@internal path /api/internal/*
	respond @internal 404

	handle /api/* {
		reverse_proxy host.docker.internal:3000
	}

	# Dev: the Angular dev servers. Production serves the built bundles.
	handle /pos/* {
		reverse_proxy host.docker.internal:4201
	}

	handle {
		reverse_proxy host.docker.internal:4200
	}
}
