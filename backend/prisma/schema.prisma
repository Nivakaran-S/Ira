generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
  runtime             = "nodejs"
}

datasource db {
  provider = "postgresql"
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

enum UserStatus {
  ACTIVE
  DISABLED
}

// ─────────────── Platform tables: no tenantId-based RLS ───────────────

model Plan {
  id           String   @id @default(uuid(7)) @db.Uuid
  key          String   @unique
  name         String
  maxStores    Int
  maxDevices   Int
  maxUsers     Int
  maxProducts  Int      @default(5000)
  /// Monthly price in minor units of `currency`; 0 = free, no invoices.
  priceMonthly Int      @default(0)
  currency     String   @default("LKR")
  /// Days after an invoice's due date before an unpaid tenant is suspended.
  graceDays    Int      @default(15)
  tenants      Tenant[]
}

model BusinessType {
  id              String   @id @default(uuid(7)) @db.Uuid
  key             String   @unique
  name            String
  description     String?
  modules         String[]
  roleTemplates   Json
  defaultSettings Json     @default("{}")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  tenants         Tenant[]
}

model Tenant {
  id              String         @id @db.Uuid
  name            String
  slug            String         @unique
  status          TenantStatus   @default(ACTIVE)
  /// Why the tenant is suspended: null (manual) or 'billing' (lifted automatically when paid).
  suspendedReason String?
  businessTypeId  String         @db.Uuid
  planId          String         @db.Uuid
  country         String
  currency        String
  timezone        String
  settings        Json           @default("{}")
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  deletedAt       DateTime?
  businessType    BusinessType   @relation(fields: [businessTypeId], references: [id])
  plan            Plan           @relation(fields: [planId], references: [id])
  domains         Domain[]
  moduleOverrides TenantModule[]
  stores          Store[]
  users           User[]
  roles           Role[]
  invoices        Invoice[]
  billingPayments BillingPayment[]
}

/// Platform-managed. Has tenantId but is read before any tenant context exists (host resolution).
model Domain {
  id                String    @id @default(uuid(7)) @db.Uuid
  tenantId          String    @db.Uuid
  hostname          String    @unique
  verificationToken String
  verifiedAt        DateTime?
  lastCheckedAt     DateTime?
  createdAt         DateTime  @default(now())
  tenant            Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

/// Platform-managed per-tenant module overrides.
model TenantModule {
  tenantId  String   @db.Uuid
  moduleKey String
  enabled   Boolean
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, moduleKey])
}

model SuperAdmin {
  id                  String                  @id @default(uuid(7)) @db.Uuid
  email               String                  @unique
  name                String
  passwordHash        String?
  totpSecretEnc       String?
  totpLastCounter     Int?
  setupTokenHash      String?                 @unique
  setupTokenExpiresAt DateTime?
  failedLoginCount    Int                     @default(0)
  lockedUntil         DateTime?
  createdAt           DateTime                @default(now())
  families            PlatformRefreshFamily[]
}

model PlatformRefreshFamily {
  id                String                 @id @default(uuid(7)) @db.Uuid
  superAdminId      String                 @db.Uuid
  createdAt         DateTime               @default(now())
  absoluteExpiresAt DateTime
  revokedAt         DateTime?
  superAdmin        SuperAdmin             @relation(fields: [superAdminId], references: [id], onDelete: Cascade)
  tokens            PlatformRefreshToken[]
}

model PlatformRefreshToken {
  id        String                @id @default(uuid(7)) @db.Uuid
  familyId  String                @db.Uuid
  tokenHash String                @unique
  expiresAt DateTime
  usedAt    DateTime?
  family    PlatformRefreshFamily @relation(fields: [familyId], references: [id], onDelete: Cascade)
}

model PlatformAuditEvent {
  id            String   @id @db.Uuid
  seq           BigInt   @unique @default(autoincrement())
  actorId       String?  @db.Uuid
  action        String
  entityType    String
  entityId      String?
  before        Json?
  after         Json?
  ip            String?
  userAgent     String?
  correlationId String?
  prevHash      String
  hash          String
  createdAt     DateTime
}

// ─────────────── Tenant-scoped tables: RLS on tenantId ───────────────
// Relations between tenant-scoped tables use composite (tenantId, id) keys so a row can
// never reference another tenant's row: Postgres FK checks do not apply RLS.

model Store {
  id        String       @id @default(uuid(7)) @db.Uuid
  tenantId  String       @db.Uuid
  name      String
  code      String
  createdAt DateTime     @default(now())
  tenant    Tenant       @relation(fields: [tenantId], references: [id])
  registers Register[]
  stock     StockLevel[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
}

model Register {
  id          String             @id @default(uuid(7)) @db.Uuid
  tenantId    String             @db.Uuid
  storeId     String             @db.Uuid
  name        String
  code        String
  createdAt   DateTime           @default(now())
  /// Last receipt sequence handed out for this register.
  receiptSeq  Int                @default(0)
  /// Last offline receipt number reserved for a device of this register ({code}-O{n}).
  offlineSeq  Int                @default(0)
  store       Store              @relation(fields: [tenantId, storeId], references: [tenantId, id])
  devices     Device[]
  enrollments DeviceEnrollment[]
  shifts      Shift[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
}

model User {
  id                  String          @id @default(uuid(7)) @db.Uuid
  tenantId            String          @db.Uuid
  email               String?
  name                String
  passwordHash        String?
  pinHash             String?
  totpSecretEnc       String?
  totpLastCounter     Int?
  setupTokenHash      String?         @unique
  setupTokenExpiresAt DateTime?
  status              UserStatus      @default(ACTIVE)
  failedLoginCount    Int             @default(0)
  lockedUntil         DateTime?
  pinFailedCount      Int             @default(0)
  pinLockedUntil      DateTime?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  tenant              Tenant          @relation(fields: [tenantId], references: [id])
  roles               UserRole[]
  families            RefreshFamily[]

  @@unique([tenantId, id])
  @@unique([tenantId, email])
}

model Role {
  id          String     @id @default(uuid(7)) @db.Uuid
  tenantId    String     @db.Uuid
  name        String
  permissions String[]
  requiresMfa Boolean    @default(false)
  isSystem    Boolean    @default(false)
  createdAt   DateTime   @default(now())
  tenant      Tenant     @relation(fields: [tenantId], references: [id])
  users       UserRole[]

  @@unique([tenantId, id])
  @@unique([tenantId, name])
}

model UserRole {
  tenantId String @db.Uuid
  userId   String @db.Uuid
  roleId   String @db.Uuid
  user     User   @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Cascade)
  role     Role   @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: Cascade)

  @@id([userId, roleId])
}

model Device {
  id                String    @id @default(uuid(7)) @db.Uuid
  tenantId          String    @db.Uuid
  registerId        String    @db.Uuid
  name              String
  publicKeyJwk      Json
  enrolledById      String    @db.Uuid
  enrolledAt        DateTime  @default(now())
  revokedAt         DateTime?
  /// Receipt numbers reserved for offline sales on this device: [offlineBlockStart, offlineBlockEnd].
  offlineBlockStart Int?
  offlineBlockEnd   Int?
  register          Register  @relation(fields: [tenantId, registerId], references: [tenantId, id])

  @@unique([tenantId, id])
}

model DeviceEnrollment {
  id          String    @id @default(uuid(7)) @db.Uuid
  tenantId    String    @db.Uuid
  registerId  String    @db.Uuid
  codeHash    String
  createdById String    @db.Uuid
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())
  register    Register  @relation(fields: [tenantId, registerId], references: [tenantId, id])

  @@unique([tenantId, codeHash])
}

model RefreshFamily {
  id                String         @id @default(uuid(7)) @db.Uuid
  tenantId          String         @db.Uuid
  userId            String         @db.Uuid
  deviceId          String?        @db.Uuid
  createdAt         DateTime       @default(now())
  absoluteExpiresAt DateTime
  revokedAt         DateTime?
  user              User           @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Cascade)
  tokens            RefreshToken[]

  @@unique([tenantId, id])
}

model RefreshToken {
  id        String        @id @default(uuid(7)) @db.Uuid
  tenantId  String        @db.Uuid
  familyId  String        @db.Uuid
  tokenHash String        @unique
  expiresAt DateTime
  usedAt    DateTime?
  family    RefreshFamily @relation(fields: [tenantId, familyId], references: [tenantId, id], onDelete: Cascade)
}

model AuditEvent {
  id             String   @id @db.Uuid
  tenantId       String   @db.Uuid
  seq            BigInt   @unique @default(autoincrement())
  actorUserId    String?  @db.Uuid
  impersonatorId String?  @db.Uuid
  deviceId       String?  @db.Uuid
  action         String
  entityType     String
  entityId       String?
  before         Json?
  after          Json?
  ip             String?
  userAgent      String?
  correlationId  String?
  prevHash       String
  hash           String
  createdAt      DateTime

  @@index([tenantId, seq])
}

// ─────────────── Catalog ───────────────

model TaxRate {
  id        String         @id @default(uuid(7)) @db.Uuid
  tenantId  String         @db.Uuid
  name      String
  rateBp    Int
  compound  Boolean        @default(false)
  active    Boolean        @default(true)
  createdAt DateTime       @default(now())
  groups    TaxGroupRate[]

  @@unique([tenantId, id])
  @@unique([tenantId, name])
}

model TaxGroup {
  id        String         @id @default(uuid(7)) @db.Uuid
  tenantId  String         @db.Uuid
  name      String
  version   BigInt         @default(dbgenerated("nextval('sync_version')"))
  createdAt DateTime       @default(now())
  rates     TaxGroupRate[]
  products  Product[]

  @@unique([tenantId, id])
  @@unique([tenantId, name])
}

model TaxGroupRate {
  tenantId String   @db.Uuid
  groupId  String   @db.Uuid
  rateId   String   @db.Uuid
  position Int
  group    TaxGroup @relation(fields: [tenantId, groupId], references: [tenantId, id], onDelete: Cascade)
  rate     TaxRate  @relation(fields: [tenantId, rateId], references: [tenantId, id])

  @@id([groupId, rateId])
}

model Category {
  id        String    @id @default(uuid(7)) @db.Uuid
  tenantId  String    @db.Uuid
  name      String
  version   BigInt    @default(dbgenerated("nextval('sync_version')"))
  color     String?
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  products  Product[]

  @@unique([tenantId, id])
  @@unique([tenantId, name])
}

model Product {
  id             String                 @id @default(uuid(7)) @db.Uuid
  tenantId       String                 @db.Uuid
  name           String
  version        BigInt                 @default(dbgenerated("nextval('sync_version')"))
  sku            String?
  categoryId     String?                @db.Uuid
  taxGroupId     String?                @db.Uuid
  price          Int
  active         Boolean                @default(true)
  trackStock     Boolean                @default(true)
  customFields   Json                   @default("{}")
  /// Variants module: a family (hasVariants) is not sold itself; its variants are products with parentId.
  hasVariants    Boolean                @default(false)
  parentId       String?                @db.Uuid
  variantLabel   String?
  /// Last purchase cost (minor units); sale lines snapshot it for margins.
  costPrice      Int                    @default(0)
  /// Low-stock warning level (thousandths); null = no warning.
  reorderPoint   Int?
  /// Weighed-items: price per kg, quantities are weights (1 kg = 1000).
  soldByWeight   Boolean                @default(false)
  /// Scale label number.
  plu            String?
  /// Batch-expiry: stock in dated lots, sold first-expiring-first.
  tracksBatches  Boolean                @default(false)
  /// Prescriptions: only sold against a prescription item.
  rxRequired     Boolean                @default(false)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  category       Category?              @relation(fields: [tenantId, categoryId], references: [tenantId, id])
  taxGroup       TaxGroup?              @relation(fields: [tenantId, taxGroupId], references: [tenantId, id])
  stock          StockLevel[]
  movements      StockMovement[]
  parent         Product?               @relation("Variants", fields: [tenantId, parentId], references: [tenantId, id])
  variants       Product[]              @relation("Variants")
  barcodes       Barcode[]
  modifierGroups ProductModifierGroup[]

  @@unique([tenantId, id])
  @@unique([tenantId, sku])
  @@unique([tenantId, plu])
  @@index([tenantId, parentId])
}

// ─────────────── Inventory ───────────────

model StockLevel {
  tenantId  String   @db.Uuid
  storeId   String   @db.Uuid
  productId String   @db.Uuid
  qtyMilli  Int      @default(0)
  updatedAt DateTime @updatedAt
  store     Store    @relation(fields: [tenantId, storeId], references: [tenantId, id])
  product   Product  @relation(fields: [tenantId, productId], references: [tenantId, id])

  @@id([storeId, productId])
}

enum StockReason {
  SALE
  REFUND
  VOID
  ADJUSTMENT
  RECEIVE
  TRANSFER_IN
  TRANSFER_OUT
}

/// Append-only.
model StockMovement {
  id         String      @id @default(uuid(7)) @db.Uuid
  tenantId   String      @db.Uuid
  storeId    String      @db.Uuid
  productId  String      @db.Uuid
  deltaMilli Int
  reason     StockReason
  refType    String?
  refId      String?     @db.Uuid
  note       String?
  userId     String?     @db.Uuid
  batchId    String?     @db.Uuid
  createdAt  DateTime    @default(now())
  product    Product     @relation(fields: [tenantId, productId], references: [tenantId, id])

  @@index([tenantId, productId, createdAt])
}

// ─────────────── Shifts and cash ───────────────

enum ShiftStatus {
  OPEN
  CLOSED
}

model Shift {
  id           String         @id @default(uuid(7)) @db.Uuid
  tenantId     String         @db.Uuid
  storeId      String         @db.Uuid
  registerId   String         @db.Uuid
  status       ShiftStatus    @default(OPEN)
  openedById   String         @db.Uuid
  openedAt     DateTime       @default(now())
  openingFloat Int
  closedById   String?        @db.Uuid
  closedAt     DateTime?
  expectedCash Int?
  countedCash  Int?
  variance     Int?
  note         String?
  /// Set when an offline close op closed the shift.
  closeOpId    String?        @db.Uuid
  register     Register       @relation(fields: [tenantId, registerId], references: [tenantId, id])
  movements    CashMovement[]
  sales        Sale[]

  @@unique([tenantId, id])
  @@index([tenantId, registerId, openedAt])
}

enum CashMovementType {
  PAY_IN
  PAY_OUT
  NO_SALE
}

model CashMovement {
  id           String           @id @default(uuid(7)) @db.Uuid
  tenantId     String           @db.Uuid
  shiftId      String           @db.Uuid
  type         CashMovementType
  amount       Int
  reason       String
  userId       String           @db.Uuid
  approvedById String?          @db.Uuid
  createdAt    DateTime         @default(now())
  shift        Shift            @relation(fields: [tenantId, shiftId], references: [tenantId, id])
}

// ─────────────── Sales ───────────────

enum SaleStatus {
  COMPLETED
  VOIDED
}

enum PaymentMethod {
  CASH
  CARD
  OTHER
  LOYALTY
  STORE_CREDIT
}

model Sale {
  id               String     @id @db.Uuid
  tenantId         String     @db.Uuid
  storeId          String     @db.Uuid
  registerId       String     @db.Uuid
  shiftId          String     @db.Uuid
  deviceId         String     @db.Uuid
  cashierId        String     @db.Uuid
  receiptNo        String
  status           SaleStatus @default(COMPLETED)
  pricesIncludeTax Boolean
  subtotal         Int
  discountTotal    Int
  taxTotal         Int
  total            Int
  /// Cash rounding applied on top of total (signed).
  rounding         Int        @default(0)
  /// Amount due: total + rounding.
  due              Int
  change           Int        @default(0)
  taxes            Json
  cartDiscount     Json?
  approvals        Json       @default("[]")
  /// Customers module.
  customerId       String?    @db.Uuid
  /// Loyalty points earned by this sale (reversed on void and, pro rata, on refund).
  loyaltyEarned    Int        @default(0)
  /// Promotions applied: [{promotionId, label, amount}] across lines and cart.
  promotions       Json       @default("[]")
  /// Gratuity on top of `due`; payments add up to due + tip. Not revenue.
  tip              Int        @default(0)
  /// Tables module: the order (tab) this sale paid for, in full or in part.
  orderId          String?    @db.Uuid
  soldAt           DateTime
  createdAt        DateTime   @default(now())
  /// Rung up offline and synced later; catalogVersion is the down-sync cursor the till priced it with.
  offline          Boolean    @default(false)
  catalogVersion   BigInt?
  voidedAt         DateTime?
  voidedById       String?    @db.Uuid
  voidReason       String?
  /// Set when an offline void op voided the sale, so a resent op is recognised.
  voidOpId         String?          @db.Uuid
  shift            Shift      @relation(fields: [tenantId, shiftId], references: [tenantId, id])
  lines            SaleLine[]
  payments         Payment[]
  refunds          Refund[]

  @@unique([tenantId, id])
  @@unique([tenantId, receiptNo])
  @@index([tenantId, soldAt])
  @@index([tenantId, customerId, soldAt])
}

model SaleLine {
  id                 String       @id @default(uuid(7)) @db.Uuid
  tenantId           String       @db.Uuid
  saleId             String       @db.Uuid
  position           Int
  productId          String       @db.Uuid
  name               String
  sku                String?
  unitPrice          Int
  listPrice          Int
  qtyMilli           Int
  gross              Int
  discount           Int
  discounts          Json
  net                Int
  tax                Int
  taxes              Json
  total              Int
  note               String?
  /// Modifiers chosen: [{id, name, priceDelta}]; unitPrice and listPrice include them.
  modifiers          Json         @default("[]")
  orderLineId        String?      @db.Uuid
  /// Product cost when sold, for margin reports.
  unitCost           Int          @default(0)
  /// Lots this line was taken from: [{batchId, lotNo, expiresOn, qtyMilli}].
  batches            Json         @default("[]")
  prescriptionItemId String?      @db.Uuid
  refundedQtyMilli   Int          @default(0)
  sale               Sale         @relation(fields: [tenantId, saleId], references: [tenantId, id], onDelete: Cascade)
  refundLines        RefundLine[]

  @@unique([tenantId, id])
}

model Payment {
  id        String        @id @default(uuid(7)) @db.Uuid
  tenantId  String        @db.Uuid
  saleId    String        @db.Uuid
  method    PaymentMethod
  amount    Int
  tendered  Int?
  change    Int           @default(0)
  reference String?
  /// Integrated terminal result: scheme, last4, authCode, terminalRef.
  card      Json?
  sale      Sale          @relation(fields: [tenantId, saleId], references: [tenantId, id], onDelete: Cascade)
}

model Refund {
  id           String        @id @db.Uuid
  tenantId     String        @db.Uuid
  saleId       String        @db.Uuid
  storeId      String        @db.Uuid
  registerId   String        @db.Uuid
  shiftId      String        @db.Uuid
  deviceId     String        @db.Uuid
  userId       String        @db.Uuid
  approvedById String?       @db.Uuid
  receiptNo    String
  method       PaymentMethod
  reason       String
  restock      Boolean
  total        Int
  taxTotal     Int
  /// Cash rounding on the payout (signed); paid out = total + rounding.
  rounding     Int           @default(0)
  offline      Boolean       @default(false)
  /// Integrated terminal result for card refunds.
  card         Json?
  createdAt    DateTime      @default(now())
  sale         Sale          @relation(fields: [tenantId, saleId], references: [tenantId, id])
  lines        RefundLine[]

  @@unique([tenantId, id])
  @@unique([tenantId, receiptNo])
}

model RefundLine {
  id         String   @id @default(uuid(7)) @db.Uuid
  tenantId   String   @db.Uuid
  refundId   String   @db.Uuid
  saleLineId String   @db.Uuid
  qtyMilli   Int
  net        Int
  tax        Int
  total      Int
  refund     Refund   @relation(fields: [tenantId, refundId], references: [tenantId, id], onDelete: Cascade)
  saleLine   SaleLine @relation(fields: [tenantId, saleLineId], references: [tenantId, id])
}

// ---------------- Offline sync ----------------

/// Where each device's offline hash chain stands, and when it last talked to the server.
model SyncCursor {
  deviceId      String   @id @db.Uuid
  tenantId      String   @db.Uuid
  lastSeq       Int      @default(0)
  lastHash      String
  lastContactAt DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([tenantId, deviceId])
}

enum QuarantineStatus {
  PENDING
  ACCEPTED
  REJECTED
}

/// Offline operations that failed verification. Never applied or dropped silently: a manager decides.
model SyncQuarantine {
  id           String           @id @default(uuid(7)) @db.Uuid
  tenantId     String           @db.Uuid
  deviceId     String           @db.Uuid
  registerId   String           @db.Uuid
  opId         String           @db.Uuid
  kind         String
  seq          Int
  reason       String
  details      Json?
  op           Json
  status       QuarantineStatus @default(PENDING)
  reviewedById String?          @db.Uuid
  reviewedAt   DateTime?
  reviewNote   String?
  createdAt    DateTime         @default(now())

  @@unique([tenantId, id])
  @@unique([tenantId, deviceId, opId])
  @@index([tenantId, status, createdAt])
}

// ---------------- Retail ----------------

model Barcode {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @db.Uuid
  code      String
  productId String   @db.Uuid
  version   BigInt   @default(dbgenerated("nextval('sync_version')"))
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, code])
  @@index([tenantId, productId])
}

/// Phone and email are encrypted (AES-GCM); *Idx are HMAC blind indexes for exact lookup.
model Customer {
  id           String   @id @default(uuid(7)) @db.Uuid
  tenantId     String   @db.Uuid
  name         String
  phoneEnc     String?
  phoneIdx     String?
  phoneLast4   String?
  emailEnc     String?
  emailIdx     String?
  notes        String?
  customFields Json     @default("{}")
  /// Down-sync: bumped on update and whenever a balance changes.
  version      BigInt   @default(dbgenerated("nextval('sync_version')"))
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([tenantId, id])
  @@index([tenantId, phoneIdx])
  @@index([tenantId, emailIdx])
  @@index([tenantId, name])
}

enum LedgerReason {
  EARN
  REDEEM
  REVERSE
  REFUND
  ADJUST
  RESTORE
}

/// Append-only. Balance = sum(delta). Points for loyalty.
model LoyaltyLedger {
  id         String       @id @default(uuid(7)) @db.Uuid
  tenantId   String       @db.Uuid
  customerId String       @db.Uuid
  delta      Int
  reason     LedgerReason
  saleId     String?      @db.Uuid
  refundId   String?      @db.Uuid
  note       String?
  userId     String?      @db.Uuid
  createdAt  DateTime     @default(now())

  @@index([tenantId, customerId, createdAt])
}

/// Append-only. Balance = sum(delta). Minor units.
model StoreCreditLedger {
  id         String       @id @default(uuid(7)) @db.Uuid
  tenantId   String       @db.Uuid
  customerId String       @db.Uuid
  delta      Int
  reason     LedgerReason
  saleId     String?      @db.Uuid
  refundId   String?      @db.Uuid
  note       String?
  userId     String?      @db.Uuid
  createdAt  DateTime     @default(now())

  @@index([tenantId, customerId, createdAt])
}

enum PromotionKind {
  PERCENT_OFF
  AMOUNT_OFF
  BUY_X_GET_Y
  SPEND_THRESHOLD
}

model Promotion {
  id           String        @id @default(uuid(7)) @db.Uuid
  tenantId     String        @db.Uuid
  name         String
  kind         PromotionKind
  productIds   String[]      @db.Uuid
  categoryIds  String[]      @db.Uuid
  active       Boolean       @default(true)
  startsAt     DateTime?
  endsAt       DateTime?
  percentBp    Int?
  amount       Int?
  buyQty       Int?
  getQty       Int?
  getPercentBp Int?
  minSpend     Int?
  version      BigInt        @default(dbgenerated("nextval('sync_version')"))
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([tenantId, id])
}

// ---------------- Restaurant ----------------

model ModifierGroup {
  id        String                 @id @default(uuid(7)) @db.Uuid
  tenantId  String                 @db.Uuid
  name      String
  minSelect Int                    @default(0)
  maxSelect Int                    @default(1)
  version   BigInt                 @default(dbgenerated("nextval('sync_version')"))
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt
  options   Modifier[]
  products  ProductModifierGroup[]

  @@unique([tenantId, id])
  @@unique([tenantId, name])
}

model Modifier {
  id         String        @id @default(uuid(7)) @db.Uuid
  tenantId   String        @db.Uuid
  groupId    String        @db.Uuid
  name       String
  priceDelta Int           @default(0)
  active     Boolean       @default(true)
  position   Int           @default(0)
  group      ModifierGroup @relation(fields: [tenantId, groupId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
}

model ProductModifierGroup {
  tenantId  String        @db.Uuid
  productId String        @db.Uuid
  groupId   String        @db.Uuid
  position  Int           @default(0)
  product   Product       @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Cascade)
  group     ModifierGroup @relation(fields: [tenantId, groupId], references: [tenantId, id], onDelete: Cascade)

  @@id([productId, groupId])
}

model DiningTable {
  id        String   @id @default(uuid(7)) @db.Uuid
  tenantId  String   @db.Uuid
  storeId   String   @db.Uuid
  name      String
  area      String?
  seats     Int      @default(2)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  orders    Order[]

  @@unique([tenantId, id])
  @@unique([tenantId, storeId, name])
}

enum OrderStatus {
  OPEN
  CLOSED
  CANCELLED
}

enum OrderLineStatus {
  NEW
  SENT
  PREPARING
  READY
  SERVED
  VOID
}

/// A tab: a table's (or counter customer's) running order, shared by every till in the store.
model Order {
  id         String       @id @db.Uuid
  tenantId   String       @db.Uuid
  storeId    String       @db.Uuid
  tableId    String?      @db.Uuid
  name       String?
  guests     Int?
  status     OrderStatus  @default(OPEN)
  openedById String       @db.Uuid
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  closedAt   DateTime?
  table      DiningTable? @relation(fields: [tenantId, tableId], references: [tenantId, id])
  lines      OrderLine[]

  @@unique([tenantId, id])
  @@index([tenantId, storeId, status])
}

model OrderLine {
  id           String          @id @db.Uuid
  tenantId     String          @db.Uuid
  orderId      String          @db.Uuid
  productId    String          @db.Uuid
  name         String
  qtyMilli     Int
  paidQtyMilli Int             @default(0)
  /// Base price plus modifiers, as added. Paying re-prices from the catalog.
  unitPrice    Int
  modifiers    Json            @default("[]")
  note         String?
  course       Int             @default(1)
  status       OrderLineStatus @default(NEW)
  sentAt       DateTime?
  readyAt      DateTime?
  createdById  String          @db.Uuid
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  order        Order           @relation(fields: [tenantId, orderId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@index([tenantId, status, sentAt])
}

// ---------------- Grocery and pharmacy ----------------

model Batch {
  id         String   @id @default(uuid(7)) @db.Uuid
  tenantId   String   @db.Uuid
  storeId    String   @db.Uuid
  productId  String   @db.Uuid
  lotNo      String
  expiresOn  DateTime @db.Date
  qtyMilli   Int      @default(0)
  receivedAt DateTime @default(now())

  @@unique([tenantId, id])
  @@unique([tenantId, storeId, productId, lotNo])
  @@index([tenantId, storeId, expiresOn])
}

model Prescription {
  id              String             @id @default(uuid(7)) @db.Uuid
  tenantId        String             @db.Uuid
  customerId      String             @db.Uuid
  prescriber      String
  prescriberRegNo String?
  issuedOn        DateTime           @db.Date
  notes           String?
  createdById     String             @db.Uuid
  createdAt       DateTime           @default(now())
  items           PrescriptionItem[]

  @@unique([tenantId, id])
  @@index([tenantId, customerId, issuedOn])
}

model PrescriptionItem {
  id                String       @id @default(uuid(7)) @db.Uuid
  tenantId          String       @db.Uuid
  prescriptionId    String       @db.Uuid
  productId         String       @db.Uuid
  qtyMilli          Int
  dispensedQtyMilli Int          @default(0)
  directions        String?
  prescription      Prescription @relation(fields: [tenantId, prescriptionId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
}

// ---------------- Business ----------------

/// Per-tenant counters for human-friendly document numbers (PO-000001, TR-000001).
model TenantCounter {
  tenantId String @db.Uuid
  key      String
  value    Int    @default(0)

  @@id([tenantId, key])
}

/// A store's own price for a product (multi-store); overrides Product.price at that store's tills.
model StorePrice {
  tenantId  String   @db.Uuid
  storeId   String   @db.Uuid
  productId String   @db.Uuid
  price     Int
  updatedAt DateTime @updatedAt

  @@id([storeId, productId])
  @@index([tenantId, productId])
}

/// Staff assigned to stores; a till's PIN pad shows the staff of its store (or everyone, if no one is assigned).
model UserStore {
  tenantId String @db.Uuid
  userId   String @db.Uuid
  storeId  String @db.Uuid

  @@id([userId, storeId])
}

model Supplier {
  id          String          @id @default(uuid(7)) @db.Uuid
  tenantId    String          @db.Uuid
  name        String
  contactName String?
  phone       String?
  email       String?
  notes       String?
  active      Boolean         @default(true)
  createdAt   DateTime        @default(now())
  orders      PurchaseOrder[]

  @@unique([tenantId, id])
  @@unique([tenantId, name])
}

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  PARTIAL
  RECEIVED
  CANCELLED
}

model PurchaseOrder {
  id          String              @id @default(uuid(7)) @db.Uuid
  tenantId    String              @db.Uuid
  number      String
  supplierId  String              @db.Uuid
  storeId     String              @db.Uuid
  status      PurchaseOrderStatus @default(DRAFT)
  expectedOn  DateTime?           @db.Date
  note        String?
  createdById String              @db.Uuid
  createdAt   DateTime            @default(now())
  orderedAt   DateTime?
  closedAt    DateTime?
  supplier    Supplier            @relation(fields: [tenantId, supplierId], references: [tenantId, id])
  lines       PurchaseOrderLine[]

  @@unique([tenantId, id])
  @@unique([tenantId, number])
}

model PurchaseOrderLine {
  id               String        @id @default(uuid(7)) @db.Uuid
  tenantId         String        @db.Uuid
  poId             String        @db.Uuid
  productId        String        @db.Uuid
  qtyMilli         Int
  receivedQtyMilli Int           @default(0)
  unitCost         Int
  order            PurchaseOrder @relation(fields: [tenantId, poId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
}

enum TransferStatus {
  SENT
  RECEIVED
  CANCELLED
}

model StockTransfer {
  id           String         @id @default(uuid(7)) @db.Uuid
  tenantId     String         @db.Uuid
  number       String
  fromStoreId  String         @db.Uuid
  toStoreId    String         @db.Uuid
  status       TransferStatus @default(SENT)
  note         String?
  sentById     String         @db.Uuid
  sentAt       DateTime       @default(now())
  receivedById String?        @db.Uuid
  receivedAt   DateTime?
  lines        TransferLine[]

  @@unique([tenantId, id])
  @@unique([tenantId, number])
}

model TransferLine {
  id               String        @id @default(uuid(7)) @db.Uuid
  tenantId         String        @db.Uuid
  transferId       String        @db.Uuid
  productId        String        @db.Uuid
  qtyMilli         Int
  receivedQtyMilli Int?
  /// Lots taken at the sending store: [{batchId, lotNo, expiresOn, qtyMilli}].
  batches          Json          @default("[]")
  transfer         StockTransfer @relation(fields: [tenantId, transferId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
}

enum InvoiceStatus {
  DUE
  PAID
  VOID
}

/// Platform billing. Has tenantId but is platform-managed (like Domain); tenants read their own through the API.
model Invoice {
  id          String        @id @default(uuid(7)) @db.Uuid
  tenantId    String        @db.Uuid
  number      String        @unique
  planKey     String
  periodStart DateTime      @db.Date
  periodEnd   DateTime      @db.Date
  amount      Int
  currency    String
  status      InvoiceStatus @default(DUE)
  issuedAt    DateTime      @default(now())
  dueOn       DateTime      @db.Date
  paidAt      DateTime?
  paidRef     String?
  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payments    BillingPayment[]

  @@unique([tenantId, periodStart])
  @@index([status, dueOn])
}

enum BillingPaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
}

/// An online payment attempt for an invoice through a payment gateway. Platform table.
model BillingPayment {
  id            String               @id @default(uuid(7)) @db.Uuid
  tenantId      String               @db.Uuid
  invoiceId     String               @db.Uuid
  provider      String
  /// The gateway's checkout session id.
  sessionId     String               @unique
  status        BillingPaymentStatus @default(PENDING)
  amount        Int
  currency      String
  /// The gateway's payment id once it succeeded.
  providerRef   String?
  failureReason String?
  createdAt     DateTime             @default(now())
  completedAt   DateTime?
  tenant        Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice       Invoice              @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}
