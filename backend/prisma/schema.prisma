generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
  runtime             = "nodejs"
}

datasource db {
  provider = "postgresql"
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

enum UserStatus {
  ACTIVE
  DISABLED
}

// ─────────────── Platform tables: no tenantId-based RLS ───────────────

model Plan {
  id         String   @id @default(uuid(7)) @db.Uuid
  key        String   @unique
  name       String
  maxStores  Int
  maxDevices Int
  maxUsers   Int
  tenants    Tenant[]
}

model BusinessType {
  id              String   @id @default(uuid(7)) @db.Uuid
  key             String   @unique
  name            String
  description     String?
  modules         String[]
  roleTemplates   Json
  defaultSettings Json     @default("{}")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  tenants         Tenant[]
}

model Tenant {
  id              String         @id @db.Uuid
  name            String
  slug            String         @unique
  status          TenantStatus   @default(ACTIVE)
  businessTypeId  String         @db.Uuid
  planId          String         @db.Uuid
  country         String
  currency        String
  timezone        String
  settings        Json           @default("{}")
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  deletedAt       DateTime?
  businessType    BusinessType   @relation(fields: [businessTypeId], references: [id])
  plan            Plan           @relation(fields: [planId], references: [id])
  domains         Domain[]
  moduleOverrides TenantModule[]
  stores          Store[]
  users           User[]
  roles           Role[]
}

/// Platform-managed. Has tenantId but is read before any tenant context exists (host resolution).
model Domain {
  id                String    @id @default(uuid(7)) @db.Uuid
  tenantId          String    @db.Uuid
  hostname          String    @unique
  verificationToken String
  verifiedAt        DateTime?
  lastCheckedAt     DateTime?
  createdAt         DateTime  @default(now())
  tenant            Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

/// Platform-managed per-tenant module overrides.
model TenantModule {
  tenantId  String   @db.Uuid
  moduleKey String
  enabled   Boolean
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, moduleKey])
}

model SuperAdmin {
  id                  String                  @id @default(uuid(7)) @db.Uuid
  email               String                  @unique
  name                String
  passwordHash        String?
  totpSecretEnc       String?
  totpLastCounter     Int?
  setupTokenHash      String?                 @unique
  setupTokenExpiresAt DateTime?
  failedLoginCount    Int                     @default(0)
  lockedUntil         DateTime?
  createdAt           DateTime                @default(now())
  families            PlatformRefreshFamily[]
}

model PlatformRefreshFamily {
  id                String                 @id @default(uuid(7)) @db.Uuid
  superAdminId      String                 @db.Uuid
  createdAt         DateTime               @default(now())
  absoluteExpiresAt DateTime
  revokedAt         DateTime?
  superAdmin        SuperAdmin             @relation(fields: [superAdminId], references: [id], onDelete: Cascade)
  tokens            PlatformRefreshToken[]
}

model PlatformRefreshToken {
  id        String                @id @default(uuid(7)) @db.Uuid
  familyId  String                @db.Uuid
  tokenHash String                @unique
  expiresAt DateTime
  usedAt    DateTime?
  family    PlatformRefreshFamily @relation(fields: [familyId], references: [id], onDelete: Cascade)
}

model PlatformAuditEvent {
  id            String   @id @db.Uuid
  seq           BigInt   @unique @default(autoincrement())
  actorId       String?  @db.Uuid
  action        String
  entityType    String
  entityId      String?
  before        Json?
  after         Json?
  ip            String?
  userAgent     String?
  correlationId String?
  prevHash      String
  hash          String
  createdAt     DateTime
}

// ─────────────── Tenant-scoped tables: RLS on tenantId ───────────────
// Relations between tenant-scoped tables use composite (tenantId, id) keys so a row can
// never reference another tenant's row: Postgres FK checks do not apply RLS.

model Store {
  id        String       @id @default(uuid(7)) @db.Uuid
  tenantId  String       @db.Uuid
  name      String
  code      String
  createdAt DateTime     @default(now())
  tenant    Tenant       @relation(fields: [tenantId], references: [id])
  registers Register[]
  stock     StockLevel[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
}

model Register {
  id          String             @id @default(uuid(7)) @db.Uuid
  tenantId    String             @db.Uuid
  storeId     String             @db.Uuid
  name        String
  code        String
  createdAt   DateTime           @default(now())
  /// Last receipt sequence handed out for this register.
  receiptSeq  Int                @default(0)
  store       Store              @relation(fields: [tenantId, storeId], references: [tenantId, id])
  devices     Device[]
  enrollments DeviceEnrollment[]
  shifts      Shift[]

  @@unique([tenantId, id])
  @@unique([tenantId, code])
}

model User {
  id                  String          @id @default(uuid(7)) @db.Uuid
  tenantId            String          @db.Uuid
  email               String?
  name                String
  passwordHash        String?
  pinHash             String?
  totpSecretEnc       String?
  totpLastCounter     Int?
  setupTokenHash      String?         @unique
  setupTokenExpiresAt DateTime?
  status              UserStatus      @default(ACTIVE)
  failedLoginCount    Int             @default(0)
  lockedUntil         DateTime?
  pinFailedCount      Int             @default(0)
  pinLockedUntil      DateTime?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  tenant              Tenant          @relation(fields: [tenantId], references: [id])
  roles               UserRole[]
  families            RefreshFamily[]

  @@unique([tenantId, id])
  @@unique([tenantId, email])
}

model Role {
  id          String     @id @default(uuid(7)) @db.Uuid
  tenantId    String     @db.Uuid
  name        String
  permissions String[]
  requiresMfa Boolean    @default(false)
  isSystem    Boolean    @default(false)
  createdAt   DateTime   @default(now())
  tenant      Tenant     @relation(fields: [tenantId], references: [id])
  users       UserRole[]

  @@unique([tenantId, id])
  @@unique([tenantId, name])
}

model UserRole {
  tenantId String @db.Uuid
  userId   String @db.Uuid
  roleId   String @db.Uuid
  user     User   @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Cascade)
  role     Role   @relation(fields: [tenantId, roleId], references: [tenantId, id], onDelete: Cascade)

  @@id([userId, roleId])
}

model Device {
  id           String    @id @default(uuid(7)) @db.Uuid
  tenantId     String    @db.Uuid
  registerId   String    @db.Uuid
  name         String
  publicKeyJwk Json
  enrolledById String    @db.Uuid
  enrolledAt   DateTime  @default(now())
  revokedAt    DateTime?
  register     Register  @relation(fields: [tenantId, registerId], references: [tenantId, id])

  @@unique([tenantId, id])
}

model DeviceEnrollment {
  id          String    @id @default(uuid(7)) @db.Uuid
  tenantId    String    @db.Uuid
  registerId  String    @db.Uuid
  codeHash    String
  createdById String    @db.Uuid
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())
  register    Register  @relation(fields: [tenantId, registerId], references: [tenantId, id])

  @@unique([tenantId, codeHash])
}

model RefreshFamily {
  id                String         @id @default(uuid(7)) @db.Uuid
  tenantId          String         @db.Uuid
  userId            String         @db.Uuid
  deviceId          String?        @db.Uuid
  createdAt         DateTime       @default(now())
  absoluteExpiresAt DateTime
  revokedAt         DateTime?
  user              User           @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Cascade)
  tokens            RefreshToken[]

  @@unique([tenantId, id])
}

model RefreshToken {
  id        String        @id @default(uuid(7)) @db.Uuid
  tenantId  String        @db.Uuid
  familyId  String        @db.Uuid
  tokenHash String        @unique
  expiresAt DateTime
  usedAt    DateTime?
  family    RefreshFamily @relation(fields: [tenantId, familyId], references: [tenantId, id], onDelete: Cascade)
}

model AuditEvent {
  id             String   @id @db.Uuid
  tenantId       String   @db.Uuid
  seq            BigInt   @unique @default(autoincrement())
  actorUserId    String?  @db.Uuid
  impersonatorId String?  @db.Uuid
  deviceId       String?  @db.Uuid
  action         String
  entityType     String
  entityId       String?
  before         Json?
  after          Json?
  ip             String?
  userAgent      String?
  correlationId  String?
  prevHash       String
  hash           String
  createdAt      DateTime

  @@index([tenantId, seq])
}

// ─────────────── Catalog ───────────────

model TaxRate {
  id        String         @id @default(uuid(7)) @db.Uuid
  tenantId  String         @db.Uuid
  name      String
  rateBp    Int
  compound  Boolean        @default(false)
  active    Boolean        @default(true)
  createdAt DateTime       @default(now())
  groups    TaxGroupRate[]

  @@unique([tenantId, id])
  @@unique([tenantId, name])
}

model TaxGroup {
  id        String         @id @default(uuid(7)) @db.Uuid
  tenantId  String         @db.Uuid
  name      String
  createdAt DateTime       @default(now())
  rates     TaxGroupRate[]
  products  Product[]

  @@unique([tenantId, id])
  @@unique([tenantId, name])
}

model TaxGroupRate {
  tenantId String   @db.Uuid
  groupId  String   @db.Uuid
  rateId   String   @db.Uuid
  position Int
  group    TaxGroup @relation(fields: [tenantId, groupId], references: [tenantId, id], onDelete: Cascade)
  rate     TaxRate  @relation(fields: [tenantId, rateId], references: [tenantId, id])

  @@id([groupId, rateId])
}

model Category {
  id        String    @id @default(uuid(7)) @db.Uuid
  tenantId  String    @db.Uuid
  name      String
  color     String?
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  products  Product[]

  @@unique([tenantId, id])
  @@unique([tenantId, name])
}

model Product {
  id           String          @id @default(uuid(7)) @db.Uuid
  tenantId     String          @db.Uuid
  name         String
  sku          String?
  categoryId   String?         @db.Uuid
  taxGroupId   String?         @db.Uuid
  price        Int
  active       Boolean         @default(true)
  trackStock   Boolean         @default(true)
  customFields Json            @default("{}")
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  category     Category?       @relation(fields: [tenantId, categoryId], references: [tenantId, id])
  taxGroup     TaxGroup?       @relation(fields: [tenantId, taxGroupId], references: [tenantId, id])
  stock        StockLevel[]
  movements    StockMovement[]

  @@unique([tenantId, id])
  @@unique([tenantId, sku])
}

// ─────────────── Inventory ───────────────

model StockLevel {
  tenantId  String   @db.Uuid
  storeId   String   @db.Uuid
  productId String   @db.Uuid
  qtyMilli  Int      @default(0)
  updatedAt DateTime @updatedAt
  store     Store    @relation(fields: [tenantId, storeId], references: [tenantId, id])
  product   Product  @relation(fields: [tenantId, productId], references: [tenantId, id])

  @@id([storeId, productId])
}

enum StockReason {
  SALE
  REFUND
  VOID
  ADJUSTMENT
  RECEIVE
  TRANSFER_IN
  TRANSFER_OUT
}

/// Append-only.
model StockMovement {
  id         String      @id @default(uuid(7)) @db.Uuid
  tenantId   String      @db.Uuid
  storeId    String      @db.Uuid
  productId  String      @db.Uuid
  deltaMilli Int
  reason     StockReason
  refType    String?
  refId      String?     @db.Uuid
  note       String?
  userId     String?     @db.Uuid
  createdAt  DateTime    @default(now())
  product    Product     @relation(fields: [tenantId, productId], references: [tenantId, id])

  @@index([tenantId, productId, createdAt])
}

// ─────────────── Shifts and cash ───────────────

enum ShiftStatus {
  OPEN
  CLOSED
}

model Shift {
  id           String         @id @default(uuid(7)) @db.Uuid
  tenantId     String         @db.Uuid
  storeId      String         @db.Uuid
  registerId   String         @db.Uuid
  status       ShiftStatus    @default(OPEN)
  openedById   String         @db.Uuid
  openedAt     DateTime       @default(now())
  openingFloat Int
  closedById   String?        @db.Uuid
  closedAt     DateTime?
  expectedCash Int?
  countedCash  Int?
  variance     Int?
  note         String?
  register     Register       @relation(fields: [tenantId, registerId], references: [tenantId, id])
  movements    CashMovement[]
  sales        Sale[]

  @@unique([tenantId, id])
  @@index([tenantId, registerId, openedAt])
}

enum CashMovementType {
  PAY_IN
  PAY_OUT
  NO_SALE
}

model CashMovement {
  id           String           @id @default(uuid(7)) @db.Uuid
  tenantId     String           @db.Uuid
  shiftId      String           @db.Uuid
  type         CashMovementType
  amount       Int
  reason       String
  userId       String           @db.Uuid
  approvedById String?          @db.Uuid
  createdAt    DateTime         @default(now())
  shift        Shift            @relation(fields: [tenantId, shiftId], references: [tenantId, id])
}

// ─────────────── Sales ───────────────

enum SaleStatus {
  COMPLETED
  VOIDED
}

enum PaymentMethod {
  CASH
  CARD
  OTHER
}

model Sale {
  id               String     @id @db.Uuid
  tenantId         String     @db.Uuid
  storeId          String     @db.Uuid
  registerId       String     @db.Uuid
  shiftId          String     @db.Uuid
  deviceId         String     @db.Uuid
  cashierId        String     @db.Uuid
  receiptNo        String
  status           SaleStatus @default(COMPLETED)
  pricesIncludeTax Boolean
  subtotal         Int
  discountTotal    Int
  taxTotal         Int
  total            Int
  /// Cash rounding applied on top of total (signed).
  rounding         Int        @default(0)
  /// Amount due: total + rounding.
  due              Int
  change           Int        @default(0)
  taxes            Json
  cartDiscount     Json?
  approvals        Json       @default("[]")
  soldAt           DateTime
  createdAt        DateTime   @default(now())
  voidedAt         DateTime?
  voidedById       String?    @db.Uuid
  voidReason       String?
  shift            Shift      @relation(fields: [tenantId, shiftId], references: [tenantId, id])
  lines            SaleLine[]
  payments         Payment[]
  refunds          Refund[]

  @@unique([tenantId, id])
  @@unique([tenantId, receiptNo])
  @@index([tenantId, soldAt])
}

model SaleLine {
  id               String       @id @default(uuid(7)) @db.Uuid
  tenantId         String       @db.Uuid
  saleId           String       @db.Uuid
  position         Int
  productId        String       @db.Uuid
  name             String
  sku              String?
  unitPrice        Int
  listPrice        Int
  qtyMilli         Int
  gross            Int
  discount         Int
  discounts        Json
  net              Int
  tax              Int
  taxes            Json
  total            Int
  note             String?
  refundedQtyMilli Int          @default(0)
  sale             Sale         @relation(fields: [tenantId, saleId], references: [tenantId, id], onDelete: Cascade)
  refundLines      RefundLine[]

  @@unique([tenantId, id])
}

model Payment {
  id        String        @id @default(uuid(7)) @db.Uuid
  tenantId  String        @db.Uuid
  saleId    String        @db.Uuid
  method    PaymentMethod
  amount    Int
  tendered  Int?
  change    Int           @default(0)
  reference String?
  sale      Sale          @relation(fields: [tenantId, saleId], references: [tenantId, id], onDelete: Cascade)
}

model Refund {
  id           String        @id @db.Uuid
  tenantId     String        @db.Uuid
  saleId       String        @db.Uuid
  storeId      String        @db.Uuid
  registerId   String        @db.Uuid
  shiftId      String        @db.Uuid
  deviceId     String        @db.Uuid
  userId       String        @db.Uuid
  approvedById String?       @db.Uuid
  receiptNo    String
  method       PaymentMethod
  reason       String
  restock      Boolean
  total        Int
  taxTotal     Int
  /// Cash rounding on the payout (signed); paid out = total + rounding.
  rounding     Int           @default(0)
  createdAt    DateTime      @default(now())
  sale         Sale          @relation(fields: [tenantId, saleId], references: [tenantId, id])
  lines        RefundLine[]

  @@unique([tenantId, id])
  @@unique([tenantId, receiptNo])
}

model RefundLine {
  id         String   @id @default(uuid(7)) @db.Uuid
  tenantId   String   @db.Uuid
  refundId   String   @db.Uuid
  saleLineId String   @db.Uuid
  qtyMilli   Int
  net        Int
  tax        Int
  total      Int
  refund     Refund   @relation(fields: [tenantId, refundId], references: [tenantId, id], onDelete: Cascade)
  saleLine   SaleLine @relation(fields: [tenantId, saleLineId], references: [tenantId, id])
}
